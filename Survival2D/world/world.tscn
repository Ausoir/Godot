[sub_resource type="GDScript" id=1]
script/source = "extends Timer


const sunlight = [
	[1, 1, 1],
	[1, 1, 1],
	[1, .7, .7],
	[.6, .6, .6],
	[0, 0, 0],
	[.5, .3, .7],
]

var hour = 0

func _ready():
	connect(\"timeout\", self, \"_on_timer_timeout\")


func get_cycle(arg, size):
	if arg >= size:
		return arg % size
	elif arg < 0:
		return arg % size


func _on_timer_timeout():
	hour += 1
	if hour >= 24:
		hour = 0
"

