[sub_resource type="Shader" id=26]
code = "shader_type canvas_item;

uniform float red : hint_range(0,1);
uniform float yellow : hint_range(0,1);
uniform float green : hint_range(0,1);

void fragment(){
    vec4 main_texture = texture(TEXTURE, UV);
	float r = max(yellow, max(main_texture.r, red) - green);
	float g = max(yellow, max(main_texture.g, green) - red);
	float b = max(0, main_texture.b - red - green);
    COLOR = vec4(r, g, b, main_texture.a);
}
"

