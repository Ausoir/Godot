[sub_resource type="Shader" id=24]
code = "shader_type canvas_item;

uniform float red : hint_range(0,1);
uniform float yellow : hint_range(0,1);

void fragment(){
    vec4 main_texture = texture(TEXTURE, UV);
	float r = max(yellow, max(main_texture.r, red));
	float g = max(yellow, main_texture.g - red);
	float b = max(0, main_texture.b - red);
    COLOR = vec4(r, g, b, main_texture.a);
}
"

