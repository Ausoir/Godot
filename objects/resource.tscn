[sub_resource type="GDScript" id=1]
script/source = "extends Control


var resource
var amount


func set_type(arg):
	resource = arg
	if arg == \"wood\":
		$sprite.region_rect = Rect2(0, 96, 32, 32)
	elif arg == \"stone\":
		$sprite.region_rect = Rect2(384, 64, 32, 32)
	elif arg == \"food\":
		$sprite.region_rect = Rect2(0, 32, 32, 32)


func set_amount(arg):
	$resourcelabel.set_text(str(arg))
"

