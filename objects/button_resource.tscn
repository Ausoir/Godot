func set_reqs(wood, stone, food):
	$wood.set_type(\"wood\")
	$stone.set_type(\"stone\")
	$food.set_type(\"food\")
	$wood.set_amount(wood)
	$stone.set_amount(stone)
	$food.set_amount(food)
